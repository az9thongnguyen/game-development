# bramblet — grass, stage 2 of 3: the same, plus the line's crest.
# the same finned body, asleep, sprouting.
# Nobody drew this creature. It is four tiles of textures/parts_creature.pix
# and two colour swaps, and its evolution is this file plus one more part.
mix1
name bramblet
size 16 16
sheet parts textures/parts_creature.hrt 16
part parts 7 at 0 0    # crest
part parts 1 at 0 0    # body
part parts 5 at 0 0    # face
swap 6f7686 4f9d3a    # body
swap b9c0cf bfe36a    # accent

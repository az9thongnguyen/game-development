# pyrewolf — fire, stage 3 of 3: the same again, plus its tail.
# a quadruped with a fierce face and a single horn.
# Nobody drew this creature. It is four tiles of textures/parts_creature.pix
# and two colour swaps, and its evolution is this file plus one more part.
mix1
name pyrewolf
size 16 16
sheet parts textures/parts_creature.hrt 16
part parts 9 at 0 0    # tail
part parts 6 at 0 0    # crest
part parts 0 at 0 0    # body
part parts 4 at 0 0    # face
swap 6f7686 e05a2a    # body
swap b9c0cf ffb347    # accent

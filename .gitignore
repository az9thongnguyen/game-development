# Build output
/build/
/build-*/
*.o
*.obj
*.a
*.dylib

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Editor / OS
.DS_Store
.vscode/
.idea/
.cache/

# Local Claude Code settings (machine-local)
.claude/settings.local.json

# Emscripten (M5)
*.wasm
*.wat

# Webserver runtime data (§11)
scores.json

# Colony's runtime-generated agent sprite
assets/colony_agent.hrt

# iso farm save (F5/F9 writes through the assets:: seam)
assets/farm_save.txt

# Horizon 1 local immutable release store (runtime artifacts, content-addressed)
assets/releases/
assets/channels/

# CI/smoke-scaffolded projects (ephemeral)
assets/ci_*.gameproject

# release_ops test scratch base (temp asset root)
test_ops_tmp/

# BaaS backend (Slice #1): local secrets + dev databases
baas/config.json
*.db
*.db-journal
*.db-wal
.env

# Local code-graph index (machine-local, 10 MB SQLite)
.codegraph/

# Golden-render dumps from test_shell_golden / test_ui_golden (build artifacts)
*.ppm

# document test scratch base (temp asset root)
test_document_tmp/

# Offscreen render dumps from the golden tests (PPM is already ignored above).
shell_*.png

# Runtime save games written by the games themselves.
assets/saves/
farm_*.png
farm_*.ppm
*.autosave

# Mutation-testing backups (scripts/… harness): a working-tree copy of a source
# file while one token in it is flipped. It has been committed once by accident,
# which is exactly what an ignore line is for.
*.mutbak

# Drogon's upload scratch: 256 empty tmp/00..ff directories the BaaS makes at boot.
uploads/
